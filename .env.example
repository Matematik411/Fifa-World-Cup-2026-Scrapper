# All keys are OPTIONAL. The system degrades gracefully if absent — the core
# research is done by Claude-in-session via WebSearch/WebFetch (no LLM key needed).
# Copy to `.env` and fill any you have to enrich structured fixture/stat pulls.

# https://www.football-data.org/  (free tier: 10 req/min)
FOOTBALL_DATA_API_KEY=

# https://www.api-football.com/ (RapidAPI or direct) — fixtures, lineups, results
API_FOOTBALL_KEY=

# https://the-odds-api.com/ — odds aggregation (free tier ~500 req/mo)
ODDS_API_KEY=

# Optional: your FIFA Fantasy team/entry id, if you want runs to pull your real
# squad automatically instead of you confirming it each run (see RUNBOOK.md).
FIFA_FANTASY_TEAM_ID=
