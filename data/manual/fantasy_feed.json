  "player_schema": {
    "id": "int (unique player id; join key)",
    "firstName": "str",
    "lastName": "str",
    "knownName": "str|null (display name when set, e.g. 'Bruno Fernandes', 'Lamine Yamal'; null -> use lastName)",
    "squadId": "int (FK -> squads.json id / nation)",
    "position": "str enum: GK|DEF|MID|FWD",
    "price": "number ($m, fixed all tournament; observed 3.5-10.5)",
    "status": "str enum observed: 'playing' (1248) | 'transferred' (233, left squad / unavailable)",
    "matchStatus": "str|null (live match flag; null pre-tournament)",
    "percentSelected": "number (OWNERSHIP %, current round)",
    "roundsSelected": "object {roundId(str): ownership% }",
    "stats": {
      "totalPoints": "int",
      "avgPoints": "number",
      "form": "number",
      "lastRoundPoints": "int",
      "roundPoints": "array (per-round points; empty pre-tournament)",
      "nextFixtureFromActiveRound": "int|null (fixture/tournament id)",
      "nextFixtureFromScheduledRound": "int|null (fixture/tournament id)"
    },
    "oneToWatch": "bool (FIFA 'one to watch' flag)",
    "oneToWatchText": "str|null",
    "qualificationRoundIds": "array (KO rounds the player's team has qualified for)",
    "fifaId": "str|null (external FIFA id; null pre-tournament)"
  },
  "squad_schema": {
    "id": "int",
    "name": "str (nation)",
    "group": "str (a-l, World Cup group)",
    "abbr": "str (3-letter)",
    "isEliminated": "bool"
  },
  "rounds_schema": {
    "id": "int (1-8)",
    "status": "str (scheduled|...)",
    "startDate": "ISO8601",
    "endDate": "ISO8601",
    "stage": "str (GROUP|...)",
    "tournaments": "array of fixture objects (see endpoints note)"
  },
